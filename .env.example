# Etapa 1: origen local exacto; registra el callback del mismo origen en Google.
APP_URL=http://localhost:3000
# En Vercel: origen HTTPS definitivo, o déjalo sin definir para usar
# VERCEL_PROJECT_PRODUCTION_URL. No copies localhost a producción.
# Copia ambos valores del cliente OAuth de tipo Aplicación web a .env.local.
# No compartas secretos por chat ni los subas al repositorio.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Única cuenta que podrá acceder. Comparación exacta con email verificado de Google.
ALLOWED_EMAIL=
# 32 bytes aleatorios en hexadecimal (64 caracteres): openssl rand -hex 32
SESSION_SECRET=
# Mantener false al comprobar acceso exclusivo y conectar Google, también en local.
DEMO_MODE=false
# Asistente opcional; configurar únicamente en servidor, nunca NEXT_PUBLIC_.
GEMINI_API_KEY=
# Cambiar a true SOLO tras comprobar que el proyecto de esta clave está en Free Tier sin facturación.
GEMINI_FREE_TIER_CONFIRMED=false
